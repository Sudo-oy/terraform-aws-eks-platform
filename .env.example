# Copy to .env and load it (for example with `set -a; source .env; set +a`).
# Never commit the real .env file.

# AWS authentication: use either a named profile (recommended, works with SSO) ...
AWS_PROFILE=
# ... or static credentials from your identity provider (avoid long-lived keys).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

AWS_REGION=

# Optional overrides for examples/basic
TF_VAR_name=
TF_VAR_region=
